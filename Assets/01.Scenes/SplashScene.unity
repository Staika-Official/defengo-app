    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC885\uADDC\uB2D8 \uC548\uB155\uD558\uC138\uC694. \uC774 \uBD80\uBD84\uC5D0
    \uD14D\uC2A4\uD2B8\uD0A4\uAC12\uC744 \uB123\uC5B4\uC57C\uD558\uB294\uB370 \uC81C\uAC00
    \uBC29\uBC95\uC744 \uBAA8\uB974\uACA0\uC5B4\uC11C \uC774\uB807\uAC8C \uD3B8\uC9C0\uB97C
    \uB0A8\uAE41\uB2C8\uB2E4. (\uD639\uC2DC\uB77C\uB3C4 \uC81C\uAC00 \uB098\uC911\uC5D0
    \uC78A\uC5B4\uBC84\uB9AC\uACE0 \uB9D0\uC500 \uC548\uB4DC\uB9B4\uAE4C\uBD10\uC11C\uC694)
    \uC5EC\uAE30\uC5D0 \uC5F0\uACB0\uB41C \uD14D\uC2A4\uD2B8 \uB123\uC5B4\uC8FC\uC2DC\uBA74
    \uB420 \uAC83 \uAC19\uC544\uC694! \uADF8\uB9AC\uACE0 \uC774 \uCC3D\uC774 \uC5F4\uB9B4\uB54C\uB294
    \uBC84\uD2BC\uC758 \uD654\uC0B4\uD45C\uAC00 \uC544\uB798\uB97C \uD5A5\uD558\uB3C4\uB85D
    \uC124\uC815\uD574\uC8FC\uC2DC\uBA74 \uAC10\uC0AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.
    \uADF8\uB9AC\uACE0 \uD14D\uC2A4\uD2B8 \uAE38\uC774\uC5D0 \uB9DE\uCDB0\uC11C \uBC30\uACBD
    \uC774\uBBF8\uC9C0\uAC00 \uAE38\uC5B4\uC84C\uC73C\uBA74 \uC88B\uACA0\uC2B5\uB2C8\uB2E4!"
