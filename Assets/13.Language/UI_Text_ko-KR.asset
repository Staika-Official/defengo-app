  - m_Id: 106248628123721728
    m_Localized: "\uCDA9\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 13592124363628549
    m_Localized: "\uC798\uD588\uC5B4! \uB354 \uB192\uC740 GO\uC810\uC218\uB97C \uC313\uC544\uBD10!\r\n\uB9E4\uC77C
      UTC +0\uC2DC\uC5D0 \uB204\uC801\uB41C GO\uC810\uC218\uB97C TIK\uB85C \uBCC0\uACBD\uD574\uC904\uAC70\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 131605031352786944
    m_Localized: "\uC804\uC1A1 \uC218\uC218\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 131868393168953344
    m_Localized: "\uC804\uC1A1"
    m_Metadata:
      m_Items: []
  - m_Id: 130873909625323520
    m_Localized: "\uC2A4\uD0C0\uC774\uCE74 \uC9C0\uAC11\uC5D0\uC11C \uC804\uC1A1"
    m_Metadata:
      m_Items: []
  - m_Id: 131602402128158720
    m_Localized: "\uC2A4\uD0C0\uC774\uCE74 \uC9C0\uAC11\uC73C\uB85C \uC804\uC1A1"
    m_Metadata:
      m_Items: []
  - m_Id: 13592124359434256
    m_Localized: "\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649857
    m_Localized: "\uCE74\uC6B4\uD2B8\uAC00 \uC9C0\uB098\uBA74 \uC4F0\uB808\uAE30
      \uB140\uC11D\uB4E4\uC774 \uCD9C\uBAB0\uD558\uB2C8 <color=#5AF8FF>\uBB3C\uBC29\uC6B8</color>\uC744
      \uC0AC\uC6A9\uD558\uC5EC \uC6B0\uB9AC\uB97C 4\uBC88 \uC18C\uD658\uD574\uC918!"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649866
    m_Localized: "<color=#5AF8FF>\uBB3C\uBC29\uC6B8</color>\uC744 \uC18C\uBAA8\uD574\uC11C
      <color=#FAB6FF>\uC5C5\uADF8\uB808\uC774\uB4DC</color>\uB97C \uD560 \uC218 \uC788\uC5B4\r\n\uADF8\uB7FC
      \uB354 \uAC15\uD574\uC9C8 \uC218 \uC788\uC744\uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649867
    m_Localized: "\uAC19\uC740 \uCE90\uB9AD\uD130\uAC00 \uB9CE\uC744 \uC218\uB85D
      \uB354 \uD6A8\uC728\uC801\uC774\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649868
    m_Localized: "\uACE0\uB9C8\uC6CC! \uAC8C\uC784 \uC124\uBA85\uC740 \uBAA8\uB450
      \uB05D\uB0AC\uC5B4\r\n\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC21C\uC704\uC5D0 \uB530\uB978
      <color=#C0FF9E>\uBCF4\uC0C1</color>\uC744 \uD655\uC778\uD574\uBCFC\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649869
    m_Localized: "\uC8FC\uAC04 \uCD5C\uACE0 \uAE30\uB85D\uC73C\uB85C <color=#FAB6FF>\uC804\uC138\uACC4
      \uC720\uC800</color>\uB4E4\uACFC \uACBD\uC7C1\uD558\uACE0\r\n<color=#C0FF9E>\uB2E4\uC591\uD55C
      \uBCF4\uC0C1</color>\uC744 \uD68D\uB4DD\uD574\uBD10!"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649858
    m_Localized: "\uC4F0\uB808\uAE30\uB97C \uCC98\uB9AC\uD574\uC11C <color=#5AF8FF>\uBB3C\uBC29\uC6B8</color>\uC744
      \uBAA8\uC558\uC5B4!\r\n\uB354 \uC18C\uD658\uC2DC\uCF1C\uC11C <color=#C0FF9E>\uD569\uC131</color>\uC744
      \uC9C4\uD589\uD574\uBCF4\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649859
    m_Localized: "<color=#C0FF9E>\uB3D9\uC77C\uD55C \uCE90\uB9AD\uD130\uAC00 \uC0DD\uACBC\uC5B4</color>\r\n\uB450
      \uCE90\uB9AD\uD130\uB97C <color=#FAB6FF>\uB4DC\uB798\uADF8\uD574\uC11C \uD569\uC131</color>\uD574\uBD10!\r\n\uD569\uC131\uD558\uBA74
      \uB354 \uAC15\uD55C \uB3D9\uB8CC\uAC00 <color=#FAB6FF>\uB79C\uB364</color>\uD558\uAC8C
      \uB098\uD0C0\uB0A0\uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649860
    m_Localized: "\uAC15\uD55C \uCE90\uB9AD\uD130\uB97C \uAD6C\uD588\uC73C\uB2C8,
      <color=#FFA9A2>\uBCF4\uC2A4\uBAAC\uC2A4\uD130</color>\uB97C \uC18C\uD658\uD574\uBCF4\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649861
    m_Localized: "<color=#FFA9A2>\uBCF4\uC2A4\uBAAC\uC2A4\uD130</color>\uB97C \uCC98\uCE58\uD574\uC11C\r\n\uBCF4\uC0C1\uC73C\uB85C
      \uB9CE\uC740 <color=#5AF8FF>\uBB3C\uBC29\uC6B8</color>\uC744 \uC5BB\uC5C8\uC5B4!\r\n\uD68D\uB4DD\uD55C
      <color=#5AF8FF>\uBB3C\uBC29\uC6B8</color>\uB85C \uCE5C\uAD6C\uB4E4\uC744 \uB354
      \uC18C\uD658\uD574\uBCF4\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649862
    m_Localized: "<color=#C0FF9E>\uBBF8\uC158 \uC131\uACF5!</color> \uC798\uD588\uC5B4!\r\n\uC6B0\uCE21
      \uC0C1\uB2E8\uC758 \uBBF8\uC158 \uC544\uC774\uCF58\uC744 \uB204\uB974\uBA74\r\n\uB2E4\uC591\uD55C
      \uBBF8\uC158\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 94277592230649863
    m_Localized: "\uC774\uC81C <color=#C0FF9E>\uC774\uC790</color>\uC5D0 \uB300\uD574
      \uC54C\uB824\uC904\uAC8C\r\n\uC6E8\uC774\uBE0C\uAC00 \uB05D\uB0A0\uB54C\uB9C8\uB2E4
      <color=#5AF8FF>50\uAC1C\uC758 \uBB3C\uBC29\uC6B8</color>\uB2F9\r\n<color=#C0FF9E>1\uAC1C\uC758
      \uBB3C\uBC29\uC6B8</color>\uC744 \uB354 \uC5BB\uC744 \uC218 \uC788\uC5B4"
    m_Metadata:
      m_Items: []
