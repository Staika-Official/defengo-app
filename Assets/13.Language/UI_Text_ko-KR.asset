      m_Items: []
  - m_Id: 255588767792201742
    m_Localized: "\uC774\uBBF8 \uBCF4\uC720\uD558\uACE0 \uC788\uB294 \uC2A4\uD0A8\uC785\uB2C8\uB2E4."
