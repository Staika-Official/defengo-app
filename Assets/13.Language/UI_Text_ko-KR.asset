      m_Items: []
  - m_Id: 101519496498741248
    m_Localized: "\uC601\uAD6C\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 343799254474752
    m_Localized: "<color=#FF0000>\uC774\uBBF8 \uC0AC\uC6A9\uC911\uC778 \uB2C9\uB124\uC784\uC785\uB2C8\uB2E4.</color>"
