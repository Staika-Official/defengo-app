  m_TableData:
  - m_Id: 98244753192484864
    m_Localized: "\uD589\uC6B4\uC758 \uC8FC\uC778\uACF5\uC740 \uB204\uAD6C?!\r\n{0}\uB808\uBCA8
      \uBCF4\uC2A4\uB97C \uC7A1\uACE0 STIK\uC0C1\uC790\uB97C \uD68D\uB4DD\uD574\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 98245241472385024
    m_Localized: "STIK\uC0C1\uC790\uB294 \uB0AE\uC740 \uD655\uB960\uB85C \uB4DC\uB78D\uB429\uB2C8\uB2E4.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 98245469822877696
    m_Localized: "\uBCA0\uD0C0 \uC774\uBCA4\uD2B8 \uC548\uB0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 98245593928138752
    m_Localized: "\uC774\uBCA4\uD2B8 \uBBF8\uC158 \uBCF4\uC0C1\r"
    m_Metadata:
      m_Items: []
  - m_Id: 98245741576028160
    m_Localized: "\uCD95\uD558\uD574\uC694!\r\n\uBCA0\uD0C0 \uC774\uBCA4\uD2B8\uC5D0
