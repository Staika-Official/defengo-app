  - m_Id: 207281330783772672
    m_Localized: "\uC804\uC124"
    m_Metadata:
      m_Items: []
  - m_Id: 207960818471395328
    m_Localized: "\uBD80\uD654\uC11D\uC758 \uAC1C\uC218\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 207974212389822464
    m_Localized: "\uBD80\uD654\uC11D\uC758 \uAC1C\uC218\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675840
    m_Localized: "\uC2DC\uC98C {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675841
    m_Localized: "\uD669\uC81C \uD328\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675842
    m_Localized: "\uB9C8\uAC10: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675843
    m_Localized: "\uD328\uC2A4 \uD65C\uC131\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675844
    m_Localized: "<size=40><sprite=26></size>\uBB34\uB8CC \uD328\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675845
    m_Localized: "<sprite=27>\uD504\uB9AC\uBBF8\uC5C4 \uD328\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675846
    m_Localized: "\uD504\uB9AC\uBBF8\uC5C4 \uD328\uC2A4\uB97C \uD65C\uC131\uD654\uD558\uC5EC\r\n\uD478\uC9D0\uD55C
      \uBCF4\uC0C1\uACFC \uD568\uAED8 \uC804\uC124 \uCE90\uB9AD\uD130\uB97C \uD68D\uB4DD\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675847
    m_Localized: "\uC2DC\uC98C \uAE30\uAC04: {0} ~ {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675848
    m_Localized: "\uD574\uB2F9 \uC0C1\uD488\uC740 \uAD6C\uB9E4 \uC989\uC2DC \uC0AC\uC6A9\uD55C
      \uAC83\uC73C\uB85C \uAC04\uC8FC\uB418\uC5B4 \uCCAD\uC57D\uCCA0\uD68C\uAC00
      \uBD88\uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n(\uBC95\uC815\uB300\uB9AC\uC778 \uB3D9\uC758
      \uC5C6\uB294 \uBBF8\uC131\uB144\uC790 \uBA85\uC758 \uACB0\uC81C \uC2DC \uCDE8\uC18C
      \uAC00\uB2A5)"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675849
    m_Localized: "\uD06C\uB9AC\uC2A4\uD0C8 \uAD50\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 209936234176675850
    m_Localized: "\uD55C \uBC88\uC5D0 10\uB808\uBCA8\uC744\r\n\uC62C\uB824\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 210528385476059136
    m_Localized: "\uAE30\uAC04\uC774 \uC885\uB8CC\uB41C \uCEE8\uD150\uCE20 \uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210528387782926336
    m_Localized: "\uBCF4\uC0C1 \uBC1B\uAE30\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 210531624632180736
    m_Localized: "\uD544\uC694\uD55C \uD06C\uB9AC\uC2A4\uD0C8\uC744 \uCD08\uACFC\uD558\uC5EC
      \uAD6C\uB9E4\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 212341249039917056
    m_Localized: "\uD06C\uB9AC\uC2A4\uD0C8\uC744 \uAD6C\uB9E4\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 212341533531168768
    m_Localized: "\uD06C\uB9AC\uC2A4\uD0C8 \uAD6C\uB9E4"
    m_Metadata:
      m_Items: []
  - m_Id: 212413361918304256
    m_Localized: "\uACE8\uB4DC \uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 212413501748011008
    m_Localized: "\uC2E4\uBC84 \uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 214604367954698240
    m_Localized: "\uD558\uC774\uD30C\uC774\uBE0C"
    m_Metadata:
      m_Items: []
  - m_Id: 214604374313263104
    m_Localized: "\uC774\uAE30\uC801\uC778 \uC778\uAC04\uB4E4\uC740 \uC808\uB300
      \uD611\uB825\uD560 \uC218 \uC5C6\uC9C0.\r\n\uADF8 \uACB0\uACFC\uAC00 \uC800
      \uC4F0\uB808\uAE30\uB4E4\uC778 \uAC70\uC57C.\r\n\uD55C\uC2EC\uD558\uAE30 \uC9DD\uC774
      \uC5C6\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 214604397084139520
    m_Localized: "\uC778\uC811\uD55C \uC704\uCE58\uC5D0 \uB2E4\uB978 \uD558\uC774\uBE0C\uAC00
      \uC788\uC73C\uBA74 \uC5F0\uACB0 \uC0C1\uD0DC\uAC00 \uB429\uB2C8\uB2E4.\r\n\uC5F0\uACB0\uB41C
      \uC0C1\uD0DC\uAC00 \uB9CE\uC744 \uC218\uB85D \uB370\uBBF8\uC9C0\uAC00 \uC99D\uAC00\uD558\uACE0,
      5\uAC1C \uC774\uC0C1\uC774 \uC5F0\uACB0\uB410\uC744 \uB54C \uC0AC\uAC70\uB9AC\uAC00
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 214900857984352256
    m_Localized: "\uC720\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 214900860442214400
    m_Localized: "\uC774 \uC4F0\uB808\uAE30 \uB354\uBBF8\uB4E4\uC740 \uADF8 \uB300\uAC00\uB97C
      \uCE58\uB974\uAC8C \uB420 \uAC70\uC57C.\r\n\uB0B4 \uD654\uC0B4\uC774 \uC815\uC758\uB97C
      \uCC3E\uC544\uC904 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 214900862350622720
    m_Localized: "\uC0AC\uAC70\uB9AC \uB0B4 \uC801\uC774\uC788\uC744 \uB54C \uD654\uC0B4\uBE44\uB97C
      \uB0B4\uB9BD\uB2C8\uB2E4.\r\n\uD654\uC0B4\uBE44\uB294 \uC783\uC740 \uCCB4\uB825
      \uB9CC\uD07C \uCD94\uAC00 \uB370\uBBF8\uC9C0\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 214901211690008576
    m_Localized: "\uB8E8\uB8E8"
    m_Metadata:
      m_Items: []
  - m_Id: 214901215804620800
    m_Localized: "\uB098\uB294 \uAE4A\uC740 \uBC14\uB2E4\uC758 \uC218\uD638\uC790\uC774\uC790
      \uC8FC\uC778\uC774\uC790 \uC655...\r\n\uB098\uC758 \uBC14\uB2E4\uAC00 \uB108\uD76C\uB97C
      \uC9C0\uCF1C\uC904 \uAC83\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 214901216496680960
    m_Localized: "\uB8E8\uB8E8\uAC00 \uB4F1\uC7A5\uD558\uAC70\uB098 \uC77C\uC815
      \uC2DC\uAC04\uB9C8\uB2E4 \uC131\uAE09\uC774 \uAC00\uC7A5 \uB192\uC740 \uC544\uAD70\uC5D0\uAC8C
      \uBE44\uB217\uBC29\uC6B8(\uBCF4\uD638\uB9C9)\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 214909197858734080
    m_Localized: STIK Event
    m_Metadata:
      m_Items: []
  - m_Id: 214909255538802688
    m_Localized: "{0}\uC77C \uB0A8\uC74C\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 214909526604087296
    m_Localized: "\uD2B9\uBCC4\uC0C1\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 214909667717251072
    m_Localized: Sale
    m_Metadata:
      m_Items: []
  - m_Id: 214909714806702080
    m_Localized: "\uAD6C\uB9E4\uAC00\uB2A5 ({0}/{1})"
    m_Metadata:
      m_Items: []
  - m_Id: 214909915592228864
    m_Localized: "\uC804\uC124\r\n\uD655\uC815!"
    m_Metadata:
      m_Items: []
  - m_Id: 214914039452893184
    m_Localized: "\uD604\uC7AC \uC900\uBE44\uB41C \uC0C1\uD488\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 214914161335173120
    m_Localized: "\uD574\uB2F9 \uC0C1\uD488\uC744 \uBAA8\uB450 \uAD6C\uB9E4\uD558\uC600\uC2B5\uB2C8\uB2E4.\r\n\uB354
      \uC88B\uC740 \uC0C1\uD488\uC73C\uB85C \uCC3E\uC544\uBD59\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 214947742849794048
    m_Localized: "\uCD94\uAC00 \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 214948689588092928
    m_Localized: "\uC0AC\uAC70\uB9AC \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 214948809851371520
    m_Localized: "\uC783\uC740 \uCCB4\uB825\uBE44\uB840 \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 214949448887140352
    m_Localized: "\uC9C0\uC18D\uC2DC\uAC04(\uCD08)"
    m_Metadata:
      m_Items: []
  - m_Id: 214949703519141888
    m_Localized: "\uCFE8\uD0C0\uC784(\uCD08)"
    m_Metadata:
      m_Items: []
  - m_Id: 214950058810245120
    m_Localized: "\uC0DD\uC131 \uC8FC\uAE30(\uCD08)"
    m_Metadata:
      m_Items: []
  - m_Id: 215264293370716160
    m_Localized: "\uC7A0\uC2DC \uD6C4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 216031480020721664
    m_Localized: "\uC815\uD574\uC9C4 \uAC00\uACA9\uAC12\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 216032281434775552
    m_Localized: "\uBE44\uD65C\uC131\uD654\uB41C \uBC30\uD2C0\uD328\uC2A4 \uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 218571649265426432
    m_Localized: "\uC2A4\uD2F1 \uC0C1\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 218573748002873344
    m_Localized: "\uB808\uC804\uB354\uB9AC \uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 218618273228382208
    m_Localized: "\uC7A0\uC2DC \uD6C4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 219920077920657408
    m_Localized: "\uB098\uBB34 \uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 220317643378622464
    m_Localized: "\uD504\uB85C\uD544 \uBCC0\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 220384049182531584
    m_Localized: "\uBCF4\uC11D \uAD50\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 220384088822898688
    m_Localized: "\uBCF4\uC11D \uAD50\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 221033275279638528
    m_Localized: "\uACF5\uC815\uD55C \uAC8C\uC784\uC744 \uC704\uD574 \uB300\uAE30\uD558\uACE0
      \uC788\uB294 \uC0C1\uD0DC\uC5D0\uC694.\r\n\uC7A0\uC2DC\uB9CC \uAE30\uB2E4\uB824\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 221033443399925760
    m_Localized: "\uC6D4\uC815\uC561 \uD328\uD0A4\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 221033825291304960
    m_Localized: "\uAD6C\uB9E4 \uD6C4 7\uC77C\uC774 \uACBD\uACFC\uD558\uC600\uAC70\uB098
      \uC0C1\uD488 \uC218\uB839 \uC2DC \uCCAD\uC57D \uCCA0\uD68C\uAC00 \uC81C\uD55C\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 221036227859939328
    m_Localized: "30\uC77C\uAC04 \uD6A8\uACFC \uC9C0\uC18D!"
    m_Metadata:
      m_Items: []
  - m_Id: 221036360026652672
    m_Localized: "\uC6D4\uAC04 \uBCF4\uC11D \uD328\uD0A4\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 221036362002169856
    m_Localized: "\uAD6C\uB9E4 \uC989\uC2DC!"
    m_Metadata:
      m_Items: []
  - m_Id: 221036363549868032
    m_Localized: "{0}\uC2DC\uAC04 \uB9C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 221036950614016000
    m_Localized: "\uD074\uB9AD\uD574\uC11C \uBC1B\uAE30!"
    m_Metadata:
      m_Items: []
  - m_Id: 221037007027404800
    m_Localized: "{0} \uC774\uD6C4 \uAD6C\uB9E4 \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 221136637964312576
    m_Localized: "\uCFE8\uD0C0\uC784 \uC785\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 221136642326388736
    m_Localized: "\uD328\uD0A4\uC9C0\uB97C \uAD6C\uB9E4\uD574\uC8FC\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 222477231332515840
    m_Localized: "\uC624\uB298\uC758 \uC21C\uC704\uAC00 \uC544\uC9C1 \uC815\uD574\uC9C0\uC9C0
      \uC54A\uC558\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 228671880644517888
    m_Localized: "\uC624\uB8E8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 228671885862232064
    m_Localized: "\uC624\uC624 \uD751\uB9C8\uBC95\uC0AC\uC5EC...\r\n\uB108\uC758
      \uC5B4\uB460\uC740 \uC624\uB798\uAC00\uC9C0 \uBABB\uD560 \uAC83\uC774\uB2E4.\r\n\uD669\uD63C\uC758
      \uD3ED\uD48D\uC740 \uC801\uB4E4\uC744 \uC18C\uBA78\uC2DC\uD0A4\uACE0,\r\n\uC624\uB8E8\uC2A4...
      \uB0B4\uAC00 \uADF8\uB300\uB4E4\uC744 \uAD6C\uC6D0\uD560 \uAC83\uC774\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 228672112040075264
    m_Localized: "\uD544\uB4DC\uC0C1 \uAC00\uC7A5 \uBA40\uB9AC\uC788\uB294 \uC801\uC5D0\uAC8C
      \uD669\uD63C\uC758 \uD3ED\uD48D\uC744 \uB0A0\uB9BD\uB2C8\uB2E4.\r\n\uD669\uD63C\uC758
      \uD3ED\uD48D\uC774 \uC9C0\uB098\uAC04 \uC790\uB9AC\uB294 \uCD5C\uB300 \uCCB4\uB825
      \uBE44\uB840 \uB370\uBBF8\uC9C0\uB97C \uC785\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 228742750243119104
    m_Localized: "\uCD5C\uB300 \uCCB4\uB825\uBE44\uB840 \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 229806161888903168
    m_Localized: "\uBE59\uBCBD \uC0DD\uC131 \uC8FC\uAE30 (\uCD5C\uB300)"
    m_Metadata:
      m_Items: []
  - m_Id: 229859860241809408
    m_Localized: "\uD65C\uC131\uD654\uB418\uC9C0 \uC54A\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 229859986209341440
    m_Localized: "\uC0DD\uBA85\uC758 \uD798\uC740 \uC5B8\uC81C\uB098 \uC6B0\uB9AC\uC640
      \uD568\uAED8\uD558\uC8E0.\r\n\uC774 \uC2F8\uC6C0\uC774 \uB05D\uB0A0 \uB54C,
      \uD3C9\uD654\uB294 \uB2E4\uC2DC \uCC3E\uC544\uC62C \uAC83\uC785\uB2C8\uB2E4.\r\n\uD3EC\uAE30\uD558\uC9C0
      \uB9D0\uC544\uC694, \uC790\uC5F0\uC758 \uC9C8\uC11C\uB294 \uC5B8\uC81C\uB098
      \uD68C\uBCF5\uB420 \uD14C\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 229860227037888512
    m_Localized: "\uC18C\uD658\uD558\uAC70\uB098 \uD569\uC131\uD588\uC744 \uB54C
      \uD50C\uB85C\uB77C\uAC00 \uB4F1\uC7A5\uD55C\uB2E4\uBA74 \uBB3C\uBC29\uC6B8
      \uD558\uB098\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4.\r\n4\uC131 \uC774\uC0C1\uC758
      \uD50C\uB85C\uB77C\uB294 \uC790\uC5F0\uC758 \uCE58\uC720\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\r\n\uC790\uC5F0\uC758
      \uCE58\uC720\uB294 \uAC08\uB77C\uC9C4 \uBE59\uD310\uC744 \uD68C\uBCF5\uC2DC\uD0A4\uACE0
      \uAC08\uB77C\uC9C4 \uBE59\uD310\uC774 \uC5C6\uC744 \uACBD\uC6B0 \uBE44\uB217\uBC29\uC6B8\uC744
      \uC81C\uACF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 229862133441331200
    m_Localized: "\uC790\uC5F0\uC758 \uCE58\uC720 \uCFE8\uD0C0\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 230156724922736640
    m_Localized: "\uD50C\uB85C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 235154633024069632
    m_Localized: "\uB85C\uADF8\uC778 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 235154660123467776
    m_Localized: "\uBCF4\uC2A4\uCC98\uCE58 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 235154722572460032
    m_Localized: "\uC778\uC571\uACB0\uC81C {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 235154745926344704
    m_Localized: "\uAC8C\uC784\uD50C\uB808\uC774 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 235154770744041472
    m_Localized: "\uBAAC\uC2A4\uD130 \uCC98\uCE58 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 235154890977959936
    m_Localized: "\uAD11\uACE0 \uC2DC\uCCAD  {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 235156528849477632
    m_Localized: "\uCD5C\uACE0 \uC6E8\uC774\uBE0C  {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 235156577037836288
    m_Localized: "\uBBF8\uC158 \uD074\uB9AC\uC5B4  {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 235174023958355968
    m_Localized: "\uC77C\uC77C \uD018\uC2A4\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 235174184214323200
    m_Localized: "\uC5C5\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 235175410473623552
    m_Localized: "{0:D2}\uC2DC\uAC04 {1:D2}\uBD84 {2:D2}\uCD08"
    m_Metadata:
      m_Items: []
  - m_Id: 238504248746172416
    m_Localized: "\uBCF4\uC11D \uAD50\uD658 {0} \uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 238504515076087808
    m_Localized: "\uBCF4\uC11D \uC18C\uBE44 {0} \uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 240933497352478720
    m_Localized: "\uC870\uAC74\uC774 \uCDA9\uC871\uB418\uC9C0 \uC54A\uC544 \uBCF4\uC0C1\uC744
      \uBC1B\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 240937800423170048
    m_Localized: "\uBCF4\uC0C1\uC744 \uC218\uB839\uD560 \uC218 \uC5C6\uB294 \uC0C1\uD0DC\uC785\uB2C8\uB2E4.\r\n\uB2E4\uC2DC
      \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 240938600134336512
    m_Localized: "\uC774\uBBF8 \uC218\uB839\uD55C \uBCF4\uC0C1\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 240939641118646272
    m_Localized: "\uC694\uAD6C \uC870\uAC74\uC774 \uCDA9\uC871\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 241393874347483136
    m_Localized: "\uCE90\uB9AD\uD130 \uB808\uBCA8\uC5C5 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 241393876117479424
    m_Localized: "\uCE90\uB9AD\uD130 \uC18C\uD658 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 241393948834127872
    m_Localized: "\uCE90\uB9AD\uD130 \uD569\uC131 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 241394025292095488
    m_Localized: "\uCE90\uB9AD\uD130 4\uC131{0}\uAC1C \uBCF4\uC720"
    m_Metadata:
      m_Items: []
  - m_Id: 241394060603940864
    m_Localized: "\uCE90\uB9AD\uD130 \uC5C5\uADF8\uB808\uC774\uB4DC {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 242388870320087040
    m_Localized: "\uBCF4\uC0C1 \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 243200961627389952
    m_Localized: "\uAC15\uC870\uB41C \uBD80\uBD84\uC744 <color=#CCEEFF>\uD074\uB9AD</color>\uD574
      \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 245037109389287424
    m_Localized: "\uB124\uD2B8\uC6CC\uD06C \uD658\uACBD\uC774 \uBD88\uC548\uC815\uD558\uC5EC
      \r\n\uC7AC\uC811\uC18D\uC744 \uC2DC\uB3C4\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 247468776896847872
    m_Localized: "\uBCA0\uAC00\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 247468780092907520
    m_Localized: "\uB77C\uC2A4\uBCA0\uAC00\uC2A4\uC5D0\uC11C \uC628 \uBCA0\uAC00\uC2A4\uC57C.\r\n\"\uC6B4\uBA85\uC774\uB0D0,
      \uC2E4\uB825\uC774\uB0D0? \uB2E8 \uD55C\uBC1C\uC774\uBA74 \uC99D\uBA85\uB418\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 247468782852759552
    m_Localized: "\uC77C\uBC18 \uACF5\uACA9\uACFC \uD06C\uB9AC\uD2F0\uCEEC\uC774
      \uBB34\uC791\uC704 \uB370\uBBF8\uC9C0\uB97C \uC785\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 247510052958625792
    m_Localized: "\uCD5C\uC18C \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 247510057102598144
    m_Localized: "\uCD5C\uB300 \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 247510061120741376
    m_Localized: "\uD2B9\uC218 \uC774\uD399\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 247563815488577536
    m_Localized: "\uD574\uBA38\uB9C1"
    m_Metadata:
      m_Items: []
  - m_Id: 247563819557052416
    m_Localized: "\uC544\uC774\uCFE0... \uC190\uC774 \uBBF8\uB044\uB7EC\uC84C\uB124!\r\n\uBBF8\uC548\uD574,
      \uBC84\uC2A4\uD06C!"
    m_Metadata:
      m_Items: []
  - m_Id: 247563823021547520
    m_Localized: "\uC77C\uBC18 \uACF5\uACA9 \uC2DC \uD655\uB960\uC5D0 \uB530\uB77C
      \uD574\uBA38\uB85C \uACF5\uACA9\uD569\uB2C8\uB2E4.\r\n\uD574\uBA38\uB294 \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
      \uD1B5\uD574 \uAC15\uD654\uD560 \uC218 \uC788\uC73C\uBA70 \uC5C5\uADF8\uB808\uC774\uB4DC\uC5D0
      \uC2E4\uD328\uD558\uAC70\uB098 \uCD08\uAE30\uD654\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC5C5\uADF8\uB808\uC774\uB4DC\uAC00
      10\uC774\uC0C1\uC774\uBA74 \uD574\uBA38\uC5D0 \uD604\uC7AC \uCCB4\uB825 \uBE44\uB840
      \uB370\uBBF8\uC9C0\uAC00 \uCD94\uAC00\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 248324010770685952
    m_Localized: "\uD574\uBA38\uACF5\uACA9 \uD655\uB960"
    m_Metadata:
      m_Items: []
  - m_Id: 248324012406464512
    m_Localized: "\uD574\uBA38\uACF5\uACA9 \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 248324013656367104
    m_Localized: "\uC5C5\uADF8\uB808\uC774\uB4DC \uD560\uC778\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 248324077896327168
    m_Localized: "\uC5C5\uADF8\uB808\uC774\uB4DC \uC131\uACF5 \uD655\uB960"
    m_Metadata:
      m_Items: []
  - m_Id: 248324079427248128
    m_Localized: "\uD604\uC7AC \uCCB4\uB825 \uBE44\uB840 \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 249066787349823488
    m_Localized: "\uC548\uB155! \uB098\uB294 \uD3AD\uACE0\uC57C.\r\n\uAC8C\uC784\uC744
      \uC2DC\uC791\uD558\uAE30 \uC704\uD574 <color=#C0FF9E>\uD50C\uB808\uC774</color>
      \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCFC\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 250738539173502976
    m_Localized: "\uB7AD\uD0B9\uC740 10\uBD84\uB9C8\uB2E4 \uAC31\uC2E0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 254064153993404416
    m_Localized: "\uC815\uB9D0 \uACE0\uC0DD \uB9CE\uC558\uC5B4.\r\n\uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uC120\uBB3C\uC744 \uC900\uBE44\uD588\uC5B4.\r\n<color=#C0FF9E>\uBA4B\uC9C4
      \uD65C\uC57D</color>\uC744 \uBCF4\uC5EC\uC918!"
    m_Metadata:
      m_Items: []
  - m_Id: 255588767788007424
    m_Localized: "\uC2A4\uD0A8"
    m_Metadata:
      m_Items: []
  - m_Id: 255588767788007425
    m_Localized: "\uC2A4\uD0A8 \uBCC0\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 255588767788007426
    m_Localized: "\uAE30\uBCF8 \uC2A4\uD0A8"
