      m_Items: []
  - m_Id: 101519691298996224
    m_Localized: "\uAC8C\uC784 \uB0B4 \uADDC\uC815\uC0AC\uD56D\uC744 \uC704\uBC18\uD558\uC5EC\r\n\uC11C\uBE44\uC2A4\uB97C
