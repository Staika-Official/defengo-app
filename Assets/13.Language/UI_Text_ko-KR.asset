      m_Items: []
  - m_Id: 94180050742534172
    m_Localized: "\uBAB0\uB824\uC624\uB294 \uC4F0\uB808\uAE30 \uBB34\uB9AC\uB4E4\uC744
      \uCC98\uB9AC\uD574\uC918!\r\n\uC4F0\uB808\uAE30\uB97C \uCC98\uB9AC\uD558\uAC70\uB098
      \uAC8C\uC784 \uB0B4 \uC784\uBB34\uB97C \uC218\uD589\uD558\uBA74\r\nGO\uB97C
      \uC5BB\uC744 \uC218 \uC788\uC744\uAC70\uC57C!\r\n\r\n\uB2F9\uC77C \uC313\uC778
      GO\uC5D0 \uB530\uB77C \uC21C\uC704\uAC00 \uC815\uD574\uC9C0\uACE0\r\n\uB9E4\uC77C
