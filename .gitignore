.vs/
.idea/
*.sln
*.csproj
*.user
*.unityproj
*.pidb
*.booproj

# Rider
*.sln.iml

# ========== OS 별 캐시 및 설정 ==========
# macOS
.DS_Store
._*

# Windows
Thumbs.db
Desktop.ini

# Linux
*~

# ========== 사용자 설정 ==========
*.swp
*.tmp
*.bak
*.old
*.orig

# Unity Collaborate 및 Plastic SCM
.collabignore
**/Assets/Plugins/PlasticSCM/

# Unity Cache Server
UnityCache/

