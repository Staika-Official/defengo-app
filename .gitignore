*.aab
*.xcodeproj/
*.xcworkspace/
*.xcuserstate
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# ========== 기타 제외 ==========
/ExportedObj/
/*.apk
/*.unitypackage
*.apk
*.unitypackage
*.log

# ========== 사용자에 따라 추가할 수 있는 항목 ==========
